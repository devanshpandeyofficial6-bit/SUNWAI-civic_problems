# ==============================================================================
# SUNWAI Environment Variables Configuration
# Copy this file to .env and configure for your local or cloud environment.
# ==============================================================================

# Port for the Node.js core server (Default: 3000)
PORT=3000

# AI Microservice URL (FastAPI + YOLO)
# For local development: http://127.0.0.1:5001
# For Docker Compose: http://ai-service:5001
AI_SERVICE_URL=http://127.0.0.1:5001

# AI Classification Confidence Threshold (0.0 to 1.0)
# Detections below this threshold are marked as low confidence for manual review
AI_CONFIDENCE_THRESHOLD=0.70

# Supabase Integration (Optional - Falls back to local data/db.json if omitted)
SUPABASE_URL=
SUPABASE_ANON_KEY=
